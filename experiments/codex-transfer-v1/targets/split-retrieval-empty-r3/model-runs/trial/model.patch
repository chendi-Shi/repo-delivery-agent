diff --git a/tests/test_more.py b/tests/test_more.py
index 9ecdd06..a77997f 100644
--- a/tests/test_more.py
+++ b/tests/test_more.py
@@ -1668,6 +1668,110 @@ class SplitBeforeTest(TestCase):
 class SplitAfterTest(TestCase):
     """Tests for ``split_after()``"""
 
+    def test_drop_separator(self):
+        cases = [
+            ([], []),
+            ([1, 2], [[1, 2]]),
+            ([0], [[]]),
+            ([0, 0], [[], []]),
+            ([0, 1, 0, 0, 2, 0], [[], [1], [], [2]]),
+            ([1, 0, 2], [[1], [2]]),
+        ]
+        for values, expected in cases:
+            with self.subTest(values=values):
+                self.assertEqual(
+                    list(mi.split_after(
+                        iter(values), lambda x: x == 0, keep_separator=False
+                    )),
+                    expected,
+                )
+
+    def test_drop_separator_maxsplit(self):
+        for values, limit, expected in [
+            ([1, 0, 2, 0], 0, [[1, 0, 2, 0]]),
+            ([], 0, []),
+            ([0], 1, [[]]),
+            ([1, 0, 2, 0], 1, [[1], [2, 0]]),
+            ([0, 0, 2, 0], 2, [[], [], [2, 0]]),
+            ([0, 0], 3, [[], []]),
+        ]:
+            with self.subTest(values=values, limit=limit):
+                self.assertEqual(
+                    list(mi.split_after(
+                        iter(values), lambda x: x == 0, limit,
+                        keep_separator=False,
+                    )),
+                    expected,
+                )
+
+    def test_separator_option_laziness(self):
+        for keep in (False, True):
+            with self.subTest(keep_separator=keep):
+                pulled, tested = [], []
+
+                def values():
+                    for value in [0, 1, 0, 2, 0]:
+                        pulled.append(value)
+                        yield value
+
+                def predicate(value):
+                    tested.append(value)
+                    return value == 0
+
+                chunks = mi.split_after(
+                    values(), predicate, 2, keep_separator=keep
+                )
+                self.assertEqual(pulled, [])
+                self.assertEqual(tested, [])
+                self.assertEqual(next(chunks), [0] if keep else [])
+                self.assertEqual(pulled, [0])
+                self.assertEqual(tested, [0])
+                self.assertEqual(next(chunks), [1, 0] if keep else [1])
+                self.assertEqual(pulled, [0, 1, 0])
+                self.assertEqual(tested, [0, 1, 0])
+                self.assertEqual(list(chunks), [[2, 0]])
+                self.assertEqual(pulled, [0, 1, 0, 2, 0])
+                self.assertEqual(tested, [0, 1, 0])
+
+    def test_zero_maxsplit_bypasses_predicate(self):
+        def predicate(value):
+            self.fail('predicate must not be called')
+
+        for keep in (False, True):
+            for values in ([], [0, 1, 0]):
+                with self.subTest(keep_separator=keep, values=values):
+                    self.assertEqual(
+                        list(mi.split_after(
+                            iter(values), predicate, 0, keep_separator=keep
+                        )),
+                        [values] if values else [],
+                    )
+
+    def test_keep_separator_keyword_only(self):
+        with self.assertRaises(TypeError):
+            mi.split_after([], bool, -1, False)
+
+    def test_drop_separator_predicate_exception(self):
+        def predicate(value):
+            raise RuntimeError('predicate failure')
+
+        with self.assertRaisesRegex(RuntimeError, 'predicate failure'):
+            next(mi.split_after([1], predicate, keep_separator=False))
+
+    def test_drop_separator_iterator_exception(self):
+        def values():
+            yield 0
+            raise RuntimeError('iterator failure')
+
+        for limit in (-1, 1):
+            with self.subTest(maxsplit=limit):
+                chunks = mi.split_after(
+                    values(), lambda x: x == 0, limit, keep_separator=False
+                )
+                self.assertEqual(next(chunks), [])
+                with self.assertRaisesRegex(RuntimeError, 'iterator failure'):
+                    next(chunks)
+
     def test_starts_with_sep(self):
         actual = list(mi.split_after('xooxoo', lambda c: c == 'x'))
         expected = [['x'], ['o', 'o', 'x'], ['o', 'o']]
