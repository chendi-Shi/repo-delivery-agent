+class LastFactoryTests(TestCase):
+    def test_empty_factory_results(self):
+        for value in (None, False, 0, [], {}):
+            for source in ([], iter([])):
+                with self.subTest(value=value, source=source):
+                    factory = mock.Mock(return_value=value)
+                    self.assertIs(mi.last(source, default_factory=factory), value)
+                    factory.assert_called_once_with()
+
+    def test_nonempty_preserves_identity(self):
+        factory = mock.Mock()
+        for value in (None, False, 0, [], {}):
+            for source in ([1, value], iter([1, value])):
+                with self.subTest(value=value, source=source):
+                    self.assertIs(mi.last(source, default_factory=factory), value)
+        factory.assert_not_called()
+
+    def test_factory_none_and_legacy_default(self):
+        self.assertEqual(mi.last([], 'legacy'), 'legacy')
+        self.assertIsNone(mi.last([], None, default_factory=None))
+        with self.assertRaises(ValueError):
+            mi.last(iter([]), default_factory=None)
+
+    def test_invalid_options_do_not_touch_source(self):
+        class Untouched:
+            def __iter__(self):
+                raise AssertionError('source was consumed')
+
+            def __reversed__(self):
+                raise AssertionError('source was reversed')
+
+        for factory in (0, False, 'invalid', object()):
+            with self.subTest(factory=factory):
+                with self.assertRaises(TypeError):
+                    mi.last(Untouched(), default_factory=factory)
+        for default in (None, False, 0, 'legacy'):
+            for factory in (list, 42):
+                with self.subTest(default=default, factory=factory):
+                    with self.assertRaises(ValueError):
+                        mi.last(Untouched(), default, default_factory=factory)
+
+    def test_factory_is_keyword_only(self):
+        with self.assertRaises(TypeError):
+            mi.last([], None, list)
+
+    def test_one_shot_iterator(self):
+        class Once:
+            def __init__(self, values):
+                self.values = iter(values)
+                self.iterations = 0
+
+            def __iter__(self):
+                self.iterations += 1
+                if self.iterations != 1:
+                    raise AssertionError('source was restarted')
+                return self
+
+            def __next__(self):
+                return next(self.values)
+
+        for values in ([], [1, 2, 3]):
+            with self.subTest(values=values):
+                source = Once(values)
+                factory = mock.Mock(return_value='fallback')
+                self.assertEqual(
+                    mi.last(source, default_factory=factory),
+                    3 if values else 'fallback',
+                )
+                self.assertEqual(source.iterations, 1)
+                self.assertEqual(factory.call_count, 0 if values else 1)
+
+    def test_reverse_only(self):
+        class ReverseOnly:
+            def __init__(self, values):
+                self.values = values
+
+            def __iter__(self):
+                raise AssertionError('forward iteration is forbidden')
+
+            def __reversed__(self):
+                return iter(self.values)
+
+        factory = mock.Mock(return_value='fallback')
+        self.assertEqual(
+            mi.last(ReverseOnly([7, 6, 5]), default_factory=factory), 7
+        )
+        factory.assert_not_called()
+        self.assertEqual(
+            mi.last(ReverseOnly([]), default_factory=factory), 'fallback'
+        )
+        factory.assert_called_once_with()
+
+    def test_falsey_callable(self):
+        class FalseyFactory:
+            def __bool__(self):
+                return False
+
+            def __call__(self):
+                return 'fallback'
+
+        self.assertEqual(mi.last([], default_factory=FalseyFactory()), 'fallback')
+
+    def test_factory_exceptions_propagate(self):
+        for error in (RuntimeError('factory'), IndexError('factory'),
+                      StopIteration('factory')):
+            with self.subTest(error=error):
+                factory = mock.Mock(side_effect=error)
+                with self.assertRaises(type(error)) as caught:
+                    mi.last([], default_factory=factory)
+                self.assertIs(caught.exception, error)
+                factory.assert_called_once_with()
+
+    def test_source_exceptions_propagate(self):
+        for error in (RuntimeError('source'), IndexError('source')):
+            def broken_source():
+                yield 1
+                raise error
+
+            class BrokenReverseStart:
+                def __reversed__(self):
+                    raise error
+
+            class BrokenReverseNext:
+                def __reversed__(self):
+                    return self
+
+                def __next__(self):
+                    raise error
+
+            for source in (broken_source(), BrokenReverseStart(),
+                           BrokenReverseNext()):
+                with self.subTest(error=error, source=source):
+                    factory = mock.Mock()
+                    with self.assertRaises(type(error)) as caught:
+                        mi.last(source, default_factory=factory)
+                    self.assertIs(caught.exception, error)
+                    factory.assert_not_called()
+
+
 class NthOrLastTests(TestCase):
     """Tests for ``nth_or_last()``"""
 
