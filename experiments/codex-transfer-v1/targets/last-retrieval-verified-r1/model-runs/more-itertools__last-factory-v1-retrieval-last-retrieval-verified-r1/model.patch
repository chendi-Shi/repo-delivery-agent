+class LastFactoryTests(TestCase):
+    def test_factory_called_once_only_when_empty(self):
+        calls = []
+        fallback = []
+
+        def factory():
+            calls.append(True)
+            return fallback
+
+        for make_iterable in (list, iter):
+            for value in (None, False, 0, []):
+                with self.subTest(value=value, make_iterable=make_iterable):
+                    self.assertIs(
+                        mi.last(make_iterable([1, value]), default_factory=factory),
+                        value,
+                    )
+        self.assertEqual(calls, [])
+        for iterable in ([], iter([])):
+            calls.clear()
+            self.assertIs(mi.last(iterable, default_factory=factory), fallback)
+            self.assertEqual(calls, [True])
+
+    def test_falsey_factory_results(self):
+        for value in (None, False, 0, [], {}):
+            with self.subTest(value=value):
+                self.assertIs(mi.last([], default_factory=lambda: value), value)
+
+    def test_none_factory_and_legacy_defaults(self):
+        self.assertEqual(mi.last([], 'legacy'), 'legacy')
+        self.assertIsNone(mi.last([], None, default_factory=None))
+        self.assertEqual(mi.last([1], default_factory=None), 1)
+        with self.assertRaises(ValueError):
+            mi.last([], default_factory=None)
+
+    def test_validation_before_consumption(self):
+        class Untouched:
+            def __iter__(self):
+                raise AssertionError('input consumed')
+
+            def __reversed__(self):
+                raise AssertionError('input reversed')
+
+        for factory in (42, False, [], 'invalid'):
+            with self.subTest(factory=factory):
+                with self.assertRaises(TypeError):
+                    mi.last(Untouched(), default_factory=factory)
+        for default in (None, False, 0, 'legacy'):
+            with self.subTest(default=default):
+                with self.assertRaises(ValueError):
+                    mi.last(Untouched(), default, default_factory=list)
+        with self.assertRaises(TypeError):
+            mi.last(Untouched(), None, list)
+
+    def test_one_shot_iterator(self):
+        class Once:
+            def __init__(self, values):
+                self.values = iter(values)
+                self.iterations = 0
+
+            def __iter__(self):
+                self.iterations += 1
+                if self.iterations != 1:
+                    raise AssertionError('input restarted')
+                return self
+
+            def __next__(self):
+                return next(self.values)
+
+        for values, expected in (([1, 2, 3], 3), ([], 'empty')):
+            source = Once(values)
+            self.assertEqual(
+                mi.last(source, default_factory=lambda: 'empty'), expected
+            )
+            self.assertEqual(source.iterations, 1)
+
+    def test_reverse_only(self):
+        class ReverseOnly:
+            def __init__(self, values):
+                self.values = values
+
+            def __iter__(self):
+                raise AssertionError('forward iteration forbidden')
+
+            def __reversed__(self):
+                return iter(self.values)
+
+        calls = []
+
+        def factory():
+            calls.append(True)
+            return 'empty'
+
+        self.assertEqual(mi.last(ReverseOnly([7, 6]), default_factory=factory), 7)
+        self.assertEqual(calls, [])
+        self.assertEqual(mi.last(ReverseOnly([]), default_factory=factory), 'empty')
+        self.assertEqual(calls, [True])
+
+    def test_factory_exceptions_propagate(self):
+        for error_type in (RuntimeError, IndexError, StopIteration):
+            calls = []
+            error = error_type('factory failure')
+
+            def factory():
+                calls.append(True)
+                raise error
+
+            with self.subTest(error_type=error_type):
+                with self.assertRaises(error_type) as caught:
+                    mi.last([], default_factory=factory)
+                self.assertIs(caught.exception, error)
+                self.assertEqual(calls, [True])
+
+    def test_source_exceptions_propagate(self):
+        def factory():
+            self.fail('factory called after source failure')
+
+        for error_type in (RuntimeError, IndexError):
+            error = error_type('source failure')
+
+            def source():
+                yield 1
+                raise error
+
+            class BrokenReverseSetup:
+                def __reversed__(self):
+                    raise error
+
+            for iterable in (source(), BrokenReverseSetup()):
+                with self.subTest(error_type=error_type, iterable=iterable):
+                    with self.assertRaises(error_type) as caught:
+                        mi.last(iterable, default_factory=factory)
+                    self.assertIs(caught.exception, error)
+
+            class BrokenReverseNext:
+                def __reversed__(self):
+                    def broken():
+                        raise error
+                        yield
+                    return broken()
+
+            with self.assertRaises(error_type) as caught:
+                mi.last(BrokenReverseNext(), default_factory=factory)
+            self.assertIs(caught.exception, error)
+
+
