diff --git a/tests/test_more.py b/tests/test_more.py
index 9ecdd06..5271d69 100644
--- a/tests/test_more.py
+++ b/tests/test_more.py
@@ -1668,6 +1668,117 @@ class SplitBeforeTest(TestCase):
 class SplitAfterTest(TestCase):
     """Tests for ``split_after()``"""
 
+    def test_drop_separator_chunks(self):
+        cases = [
+            ([], []),
+            ([1, 2], [[1, 2]]),
+            ([0], [[]]),
+            ([0, 0], [[], []]),
+            ([0, 1, 0, 0, 2, 0], [[], [1], [], [2]]),
+            ([1, 0, 2], [[1], [2]]),
+        ]
+        for items, expected in cases:
+            with self.subTest(items=items):
+                self.assertEqual(
+                    list(mi.split_after(
+                        iter(items), lambda x: x == 0, keep_separator=False
+                    )),
+                    expected,
+                )
+
+    def test_drop_separator_maxsplit(self):
+        cases = [
+            ([1, 0, 2, 0], 0, [[1, 0, 2, 0]]),
+            ([], 0, []),
+            ([1, 0, 2, 0], 1, [[1], [2, 0]]),
+            ([0, 0, 2, 0], 2, [[], [], [2, 0]]),
+            ([0], 1, [[]]),
+            ([0, 0], 2, [[], []]),
+            ([1, 0, 2, 0], 10, [[1], [2]]),
+        ]
+        for items, maxsplit, expected in cases:
+            with self.subTest(items=items, maxsplit=maxsplit):
+                self.assertEqual(
+                    list(mi.split_after(
+                        iter(items), lambda x: x == 0, maxsplit,
+                        keep_separator=False,
+                    )),
+                    expected,
+                )
+
+    def test_separator_option_laziness(self):
+        for keep_separator in (False, True):
+            with self.subTest(keep_separator=keep_separator):
+                pulled, tested = [], []
+
+                def values():
+                    for value in [1, 0, 2, 0]:
+                        pulled.append(value)
+                        yield value
+
+                def predicate(value):
+                    tested.append(value)
+                    return value == 0
+
+                chunks = mi.split_after(
+                    values(), predicate, maxsplit=1,
+                    keep_separator=keep_separator,
+                )
+                self.assertEqual(pulled, [])
+                self.assertEqual(tested, [])
+                self.assertEqual(next(chunks), [1, 0] if keep_separator else [1])
+                self.assertEqual(pulled, [1, 0])
+                self.assertEqual(tested, [1, 0])
+                self.assertEqual(list(chunks), [[2, 0]])
+                self.assertEqual(pulled, [1, 0, 2, 0])
+                self.assertEqual(tested, [1, 0])
+
+    def test_zero_maxsplit_bypasses_predicate(self):
+        def predicate(value):
+            self.fail('predicate must not be called')
+
+        for keep_separator in (False, True):
+            for items in ([], [0, 1, 0]):
+                with self.subTest(keep_separator=keep_separator, items=items):
+                    self.assertEqual(
+                        list(mi.split_after(
+                            iter(items), predicate, maxsplit=0,
+                            keep_separator=keep_separator,
+                        )),
+                        [items] if items else [],
+                    )
+
+    def test_keep_separator_keyword_only(self):
+        with self.assertRaises(TypeError):
+            mi.split_after([], bool, -1, False)
+        self.assertEqual(
+            list(mi.split_after([1, 0, 2, 0], lambda x: x == 0,
+                                keep_separator=True)),
+            [[1, 0], [2, 0]],
+        )
+
+    def test_drop_separator_predicate_exception(self):
+        def predicate(value):
+            raise RuntimeError('predicate failure')
+
+        with self.assertRaisesRegex(RuntimeError, 'predicate failure'):
+            next(mi.split_after(iter([1]), predicate, keep_separator=False))
+
+    def test_drop_separator_iterator_exception(self):
+        def values():
+            yield 0
+            raise RuntimeError('iterator failure')
+
+        for maxsplit in (-1, 1):
+            with self.subTest(maxsplit=maxsplit):
+                chunks = mi.split_after(
+                    values(), lambda x: x == 0, maxsplit,
+                    keep_separator=False,
+                )
+                self.assertEqual(next(chunks), [])
+                with self.assertRaisesRegex(RuntimeError, 'iterator failure'):
+                    next(chunks)
+
     def test_starts_with_sep(self):
         actual = list(mi.split_after('xooxoo', lambda c: c == 'x'))
         expected = [['x'], ['o', 'o', 'x'], ['o', 'o']]
