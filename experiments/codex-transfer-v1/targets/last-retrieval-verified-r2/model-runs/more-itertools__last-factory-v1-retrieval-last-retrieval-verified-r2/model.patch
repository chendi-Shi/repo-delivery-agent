+class LastFactoryTests(TestCase):
+    def test_lazy_factory_and_falsey_results(self):
+        for value in (None, False, 0, [], {}):
+            for make_source in (list, iter):
+                with self.subTest(value=value, source=make_source):
+                    calls = []
+
+                    def factory():
+                        calls.append(True)
+                        return value
+
+                    self.assertIs(
+                        mi.last(make_source([1, value]), default_factory=factory),
+                        value,
+                    )
+                    self.assertEqual(calls, [])
+                    self.assertIs(
+                        mi.last(make_source([]), default_factory=factory), value
+                    )
+                    self.assertEqual(calls, [True])
+
+    def test_validation_before_source_access(self):
+        class Untouched:
+            def __iter__(self):
+                raise AssertionError('input consumed')
+
+            def __reversed__(self):
+                raise AssertionError('input reversed')
+
+        for factory in (0, False, 'invalid', []):
+            with self.subTest(factory=factory):
+                with self.assertRaises(TypeError):
+                    mi.last(Untouched(), default_factory=factory)
+        for default in (None, False, 0, 'legacy'):
+            with self.subTest(default=default):
+                with self.assertRaises(ValueError):
+                    mi.last(Untouched(), default, default_factory=list)
+        with self.assertRaises(TypeError):
+            mi.last([], None, list)
+
+    def test_none_factory_and_legacy_default(self):
+        self.assertIsNone(mi.last([], None, default_factory=None))
+        self.assertEqual(mi.last([], 'legacy'), 'legacy')
+        self.assertEqual(mi.last([1], default_factory=None), 1)
+        with self.assertRaises(ValueError):
+            mi.last(iter([]), default_factory=None)
+
+    def test_one_shot_iterator(self):
+        class Once:
+            def __init__(self, values):
+                self.values = iter(values)
+                self.iterations = 0
+
+            def __iter__(self):
+                self.iterations += 1
+                if self.iterations != 1:
+                    raise AssertionError('input restarted')
+                return self
+
+            def __next__(self):
+                return next(self.values)
+
+        for values, expected in (([1, 2, 3], 3), ([], 'fallback')):
+            source = Once(values)
+            self.assertEqual(
+                mi.last(source, default_factory=lambda: 'fallback'), expected
+            )
+            self.assertEqual(source.iterations, 1)
+
+    def test_reverse_only(self):
+        class ReverseOnly:
+            def __init__(self, values):
+                self.values = values
+
+            def __iter__(self):
+                raise AssertionError('forward iteration forbidden')
+
+            def __reversed__(self):
+                return iter(self.values)
+
+        calls = []
+
+        def factory():
+            calls.append(True)
+            return 'fallback'
+
+        self.assertEqual(
+            mi.last(ReverseOnly([7, 6, 5]), default_factory=factory), 7
+        )
+        self.assertEqual(calls, [])
+        self.assertEqual(
+            mi.last(ReverseOnly([]), default_factory=factory), 'fallback'
+        )
+        self.assertEqual(calls, [True])
+
+    def test_factory_exceptions_propagate_once(self):
+        for kind in (RuntimeError, IndexError, StopIteration):
+            with self.subTest(kind=kind):
+                calls = []
+                error = kind('factory failure')
+
+                def factory():
+                    calls.append(True)
+                    raise error
+
+                with self.assertRaises(kind) as caught:
+                    mi.last([], default_factory=factory)
+                self.assertIs(caught.exception, error)
+                self.assertEqual(calls, [True])
+
+    def test_source_exceptions_propagate(self):
+        for kind in (RuntimeError, IndexError):
+            for reverse in (False, True):
+                with self.subTest(kind=kind, reverse=reverse):
+                    calls = []
+                    error = kind('source failure')
+
+                    def broken_source():
+                        if not reverse:
+                            yield 1
+                        raise error
+
+                    class ReverseOnly:
+                        def __reversed__(self):
+                            return broken_source()
+
+                    source = ReverseOnly() if reverse else broken_source()
+                    with self.assertRaises(kind) as caught:
+                        mi.last(source, default_factory=lambda: calls.append(True))
+                    self.assertIs(caught.exception, error)
+                    self.assertEqual(calls, [])
+
+
 class NthOrLastTests(TestCase):
     """Tests for ``nth_or_last()``"""
 
