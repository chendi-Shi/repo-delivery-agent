@@ -0,0 +1,16 @@
+import itertools
+
+
+def count_runs(iterable):
+    if not iterable:
+        return 0
+    current = next(iterable)
+    count = 1
+    for item in iterable:
+        if item == current:
+            count += 1
+        else:
+            yield count
+            current = item
+            count = 1
+    yield count
