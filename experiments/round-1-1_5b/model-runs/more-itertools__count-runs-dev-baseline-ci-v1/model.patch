+import itertools
+
+def count_runs(iterable):
+    runs = 0
+    current_run = 1
+    for i, x in enumerate(iterable):
+        if i == 0 or x != iterable[i-1]:
+            runs += current_run
+            current_run = 1
+        else:
+            current_run += 1
+    return runs
