+from itertools import count_runs
+
+
+def count_runs(iterable):
+    if not iterable:
+        return 0
+
+    current_run = 1
+    max_runs = 1
+
+    for i, (a, b) in enumerate(zip(iterable, iterable[1:])):
+        if a == b:
+            current_run += 1
+        else:
+            current_run = 1
+
+        max_runs = max(max_runs, current_run)
+
+    return max_runs
