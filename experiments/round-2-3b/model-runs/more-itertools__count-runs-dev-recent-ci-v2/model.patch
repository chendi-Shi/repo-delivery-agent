-class sized_iterator:
-    """Wrapper for *iterable* that implements ``__len__``.
-
-    >>> it = map(str, range(5))
-    >>> sized_it = sized_iterator(it, 5)
-    >>> len(sized_it)
-    5
-    >>> list(sized_it)
-    ['0', '1', '2', '3', '4']
