-    >>> import cmath
-    >>> xarr = [1, 2-1j, -1j, -1+2j]  # time domain
-    >>> Xarr = [2, -2-2j, -2j, 4+4j]  # frequency domain
-    >>> magnitudes, phases = zip(*map(cmath.polar, Xarr))
-    >>> all(map(cmath.isclose, dft(xarr), Xarr))
