-    def test_too_long(self):
-        it = count()
-        self.assertRaises(ValueError, lambda: mi.one(it))  # burn 0 and 1
-        self.assertEqual(next(it), 2)
-        self.assertRaises(
-            OverflowError, lambda: mi.one(it, too_long=OverflowError)
